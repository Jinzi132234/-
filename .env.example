# 复制成 .env 后填写；.env 已被 .gitignore 忽略
# 这些 Key 只在第一次生成 data/settings.json 时读取，之后请在网页「设置」里修改。

# AIHubMix（可调用 Claude / Grok / Gemini）
WB_AIHUBMIX_API_KEY=
# DeepSeek 直连
WB_DEEPSEEK_API_KEY=
# xAI 官方
WB_XAI_API_KEY=
# OpenAI 官方
WB_OPENAI_API_KEY=

# 如果访问模型接口需要代理
# HTTPS_PROXY=http://127.0.0.1:7892
# NODE_USE_ENV_PROXY=1

# 换端口
# WB_PORT=4321
