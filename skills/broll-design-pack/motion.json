{
  "conventions": {
    "time_unit": "seconds",
    "easing_defs": {
      "eio": "smoothstep x²(3−2x)",
      "eoc": "ease-out cubic 1−(1−x)³",
      "eob(k)": "ease-out-back, overshoot k",
      "spring": "eob(k=1.7) ≈6% overshoot",
      "linear": "clamp((t−in)/dur)"
    },
    "alpha_rule": "unless stated, alpha = clamp(progress × 4..5) – i.e. fully opaque in the first 20–25 % of the tween",
    "pos": "sprite centre in px",
    "jolt": "whole-frame shake jolt(t0, amp px, dur)"
  },
